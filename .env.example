# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Database Configuration (Defaults to SQLite for turnkey local dev, can be set to PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/attendance_db?schema=public"

# Authentication Secrets
AUTH_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
ADMIN_NAME="System Administrator"

# Web Push VAPID Keys (Generate with npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:admin@college.edu

# Client Environment (Vite)
VITE_API_URL=http://localhost:5000/api
